# Zcash LightwalletD Configuration
ZCASH_LIGHTWALLETD_URL=testnet.zec.rocks:443
ZCASH_LIGHTWALLETD_INSECURE=false

# Local wallet profile
ZCASH_RECEIVE_ADDRESS=your_local_receiving_address
ZCASH_WALLET_FILE=./.wallet/lightwalletd-wallet.json

# Server Configuration
PORT=3000
NODE_ENV=development

# Database
DB_PATH=./donations.db
