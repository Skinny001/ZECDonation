# Zcash LightwalletD Configuration
ZCASH_LIGHTWALLETD_URL=testnet.zec.rocks:443
ZCASH_LIGHTWALLETD_INSECURE=false

# Wallet Configuration
WALLET_BACKEND=mock
ZALLET_RPC_URL=http://127.0.0.1:8232
ZALLET_RPC_USER=your_rpc_username_here
ZALLET_RPC_PASS=your_rpc_password_here

# Platform Fee in Basis Points (100 = 1%)
PLATFORM_FEE_BPS=100

# Server Configuration
PORT=3000
NODE_ENV=development

# Database
DB_PATH=./donations.db
